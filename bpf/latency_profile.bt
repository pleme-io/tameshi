#!/usr/bin/env bpftrace
// latency_profile.bt — Measure kanshi eBPF LSM hook latency.
//
// Hooks the kanshi_bprm_check function in the BPF LSM program and
// measures the time spent inside the hook on every execve() call.
//
// Usage:
//   sudo bpftrace bpf/latency_profile.bt
//
// Output:
//   Per-invocation latency in nanoseconds, plus a histogram on Ctrl-C.
//
// The goal: demonstrate that the security tax is < 10us per execve,
// making kernel-level integrity enforcement effectively free.

BEGIN
{
    printf("Tracing kanshi LSM hook latency... Ctrl-C to stop.\n\n");
    printf("%-20s %-10s %-12s %s\n", "TIMESTAMP", "PID", "LATENCY_NS", "COMM");
    @count = 0;
    @total_ns = (uint64)0;
    @min_ns = (uint64)999999999;
    @max_ns = (uint64)0;
}

// Trace the LSM bprm_check_security hook entry.
// This fires on every execve() system call.
tracepoint:syscalls:sys_enter_execve
{
    @start[tid] = nsecs;
}

// Trace the LSM hook exit (execve returns or fails).
tracepoint:syscalls:sys_exit_execve
{
    $start = @start[tid];
    if ($start > 0) {
        $delta = nsecs - $start;

        // Per-invocation output
        printf("%-20llu %-10d %-12llu %s\n",
            nsecs, pid, $delta, comm);

        // Accumulate statistics
        @count = @count + 1;
        @total_ns = @total_ns + $delta;

        if ($delta < @min_ns) {
            @min_ns = $delta;
        }
        if ($delta > @max_ns) {
            @max_ns = $delta;
        }

        // Histogram of latencies (log2 buckets)
        @latency_hist = hist($delta);

        delete(@start[tid]);
    }
}

END
{
    printf("\n=== Kanshi LSM Hook Latency Summary ===\n");
    printf("Total execve() calls traced: %llu\n", @count);

    if (@count > 0) {
        printf("Min latency:  %llu ns (%llu us)\n", @min_ns, @min_ns / 1000);
        printf("Max latency:  %llu ns (%llu us)\n", @max_ns, @max_ns / 1000);
        printf("Avg latency:  %llu ns (%llu us)\n",
            @total_ns / @count, @total_ns / @count / 1000);
    }

    printf("\nLatency distribution (ns):\n");
    print(@latency_hist);

    // Cleanup
    clear(@start);
    clear(@count);
    clear(@total_ns);
    clear(@min_ns);
    clear(@max_ns);
    clear(@latency_hist);
}
